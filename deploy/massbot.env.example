# Скопировать на VM в /etc/massbot.env, выставить права 600 (только root/massbot могут читать).
# PUBLIC_URL сюда НЕ добавлять — его на каждый запуск подставляет deploy/start.sh
# из свежего адреса Cloudflare Tunnel.

BOT_TOKEN=1234567890:AAH...
TZ_NAME=Europe/Moscow
DB_PATH=/opt/massbot/massbot.db
DEV_MODE=0
