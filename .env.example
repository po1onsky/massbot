# Скопируй в .env (локально) или задай эти же переменные в настройках хостинга.

# Токен от @BotFather, /newbot
BOT_TOKEN=1234567890:AAH...

# Публичный HTTPS-адрес, на котором крутится этот сервис.
# Локально — адрес из ngrok (https://xxxx.ngrok-free.app), в проде — адрес хостинга.
# Без него бот не получит вебхук и кнопка меню не появится.
PUBLIC_URL=https://xxxx.ngrok-free.app

# Часовой пояс для напоминаний и расчёта "дня программы"
TZ_NAME=Europe/Moscow

# Куда пишет SQLite. На Render/Railway укажи путь на постоянном диске, иначе
# база слетит при каждом деплое.
DB_PATH=massbot.db

# Опционально: свой секрет для пути вебхука. Если не задать — генерируется
# автоматически из BOT_TOKEN, менять не обязательно.
# WEBHOOK_SECRET=

# 1 — разрешить открывать мини-апп в обычном браузере без Telegram (для разработки).
# В проде НЕ включай.
DEV_MODE=0
